{
  "name": "@moq-web/session-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end MOQT protocol conformance tests against a live relay (headless Chromium via Vitest browser mode)",
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.browser.config.ts",
    "lint": "eslint tests lib --ext .ts",
    "clean": "rm -rf node_modules/.vite"
  },
  "dependencies": {
    "@moq-web/core": "workspace:*",
    "@moq-web/session": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "4.0.18",
    "@vitest/browser-playwright": "4.0.18",
    "playwright": "^1.40.0",
    "vitest": "4.0.18"
  }
}
