{
  "name": "@moq-web/cat",
  "version": "0.2.0",
  "description": "Common Access Token (CAT/C4M) for MoQ Transport — CBOR/COSE/CWT token library",
  "keywords": [
    "moq",
    "moqt",
    "cat",
    "cose",
    "cwt",
    "cbor",
    "auth",
    "token"
  ],
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/Quicr/moq-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quicr/moq-web.git",
    "directory": "packages/cat"
  },
  "bugs": {
    "url": "https://github.com/Quicr/moq-web/issues"
  },
  "author": "Cisco Systems, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
