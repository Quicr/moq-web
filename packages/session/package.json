{
  "name": "@moq-web/session",
  "version": "0.2.0",
  "description": "Generic MOQT session management for Media over QUIC — protocol layer without media codecs",
  "keywords": [
    "moq",
    "moqt",
    "session",
    "webtransport"
  ],
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/Quicr/moq-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quicr/moq-web.git",
    "directory": "packages/session"
  },
  "bugs": {
    "url": "https://github.com/Quicr/moq-web/issues"
  },
  "author": "Cisco Systems, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "moq-web-interop": "./dist/cli/interop-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/workers/transport-worker.d.ts",
      "import": "./dist/workers/transport-worker.js"
    },
    "./interop-cli": {
      "types": "./dist/cli/interop-cli.d.ts",
      "import": "./dist/cli/interop-cli.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/prepend-cli-shebang.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moq-web/core": "workspace:^",
    "@moq-web/cat": "workspace:^"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
