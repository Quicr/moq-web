{
  "name": "@moq-web/msf",
  "version": "0.2.0",
  "description": "MOQT Streaming Format (MSF) — JSON catalogs for LOC-compliant Media over QUIC delivery",
  "keywords": [
    "moq",
    "moqt",
    "msf",
    "catalog",
    "loc",
    "media"
  ],
  "license": "BSD-2-Clause",
  "homepage": "https://github.com/Quicr/moq-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quicr/moq-web.git",
    "directory": "packages/msf"
  },
  "bugs": {
    "url": "https://github.com/Quicr/moq-web/issues"
  },
  "author": "Cisco Systems, Inc.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth-cat": {
      "types": "./dist/auth-cat/index.d.ts",
      "import": "./dist/auth-cat/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moq-web/cat": "workspace:^",
    "@moq-web/core": "workspace:^",
    "@moq-web/secure-objects": "workspace:^",
    "@moq-web/session": "workspace:^",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
