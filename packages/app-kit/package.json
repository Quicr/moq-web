{
  "name": "@moq-web/app-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable React components, hooks, and styles for moq-web demo apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./latency": "./src/latency/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./dvr": "./src/dvr/index.ts",
    "./media": "./src/media/index.ts",
    "./moqt": "./src/moqt/index.ts",
    "./shell": "./src/shell/index.ts",
    "./styles.css": "./src/styles/glass.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@moq-web/core": "workspace:*",
    "@moq-web/media": "workspace:*",
    "@moq-web/session": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
