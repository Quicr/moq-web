{
  "name": "web-moq",
  "version": "0.1.0",
  "private": true,
  "description": "Media over QUIC Transport (MOQT) TypeScript library",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "MOQT_VERSION=draft-16 pnpm -r run build",
    "build:draft-18": "MOQT_VERSION=draft-18 pnpm -r run build",
    "build:draft-16": "MOQT_VERSION=draft-16 pnpm -r run build",
    "test": "MOQT_VERSION=draft-16 pnpm -r run test",
    "test:draft-18": "MOQT_VERSION=draft-18 pnpm -r run test",
    "test:draft-16": "MOQT_VERSION=draft-16 pnpm -r run test",
    "test:e2e": "RUN_E2E=1 pnpm --filter @moq-web/session-e2e --filter @moq-web/media-e2e run test",
    "lint": "pnpm -r run lint",
    "dev": "MOQT_VERSION=draft-16 pnpm --filter @moq-web/chat-call run dev",
    "dev:studio": "MOQT_VERSION=draft-18 pnpm --filter @moq-web/studio run dev",
    "dev:catalog": "MOQT_VERSION=draft-18 pnpm --filter @moq-web/catalog-playground run dev",
    "dev:vod": "MOQT_VERSION=draft-18 pnpm --filter @moq-web/vod-dvr run dev",
    "dev:auth": "pnpm --filter @moq-web/auth-demo run dev",
    "dev:draft-18": "MOQT_VERSION=draft-18 pnpm --filter @moq-web/chat-call run dev",
    "dev:draft-16": "MOQT_VERSION=draft-16 pnpm --filter @moq-web/chat-call run dev",
    "clean": "pnpm -r run clean",
    "publish:dry-run": "pnpm --filter @moq-web/core --filter @moq-web/cat --filter @moq-web/secure-objects --filter @moq-web/session --filter @moq-web/msf --filter @moq-web/media exec pnpm publish --dry-run --no-git-checks",
    "bun:build": "MOQT_VERSION=draft-16 bun run --filter '*' build",
    "bun:test": "MOQT_VERSION=draft-16 bun run --filter '*' test",
    "bun:lint": "bun run --filter '*' lint",
    "bun:dev": "MOQT_VERSION=draft-16 bun run --filter @moq-web/chat-call dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch": ">=10.2.1"
    }
  }
}
